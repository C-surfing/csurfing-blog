---
import { Icon } from "astro-icon/components";
import Ascii from "ascii.rest/astro";

import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
	title={i18n(I18nKey.notFound)}
	description={i18n(I18nKey.notFoundDescription)}
>
	<!-- 引入右侧边栏布局管理器 -->
	<script>
		import("../scripts/right-sidebar-layout.js");
	</script>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-96"
	>
		<div
			class="card-base z-10 px-9 py-12 relative w-full flex flex-col items-center justify-center text-center"
		>
            <!-- ASCII 404 with a small drifting ghost -->
            <div class="w-full max-w-full overflow-hidden flex justify-center mb-6">
                <Ascii
                    piece="not-found"
                    class="ascii-not-found"
                    label="404 - Page not found"
                    options={{
                        code: "404",
                        title: "page not found",
                        message: "the page may have moved",
                    }}
                />
            </div>

			<!-- 标题 -->
			<h1 class="text-3xl md:text-4xl font-bold mb-4 text-90">
				{i18n(I18nKey.notFoundTitle)}
			</h1>

			<!-- 描述 -->
			<p class="text-lg text-75 mb-8 max-w-md">
				{i18n(I18nKey.notFoundDescription)}
			</p>

			<!-- 返回首页按钮 -->
			<a
				href="/"
				class="inline-flex items-center gap-2 px-6 py-3 bg-(--primary) text-white rounded-(--radius-large) hover:opacity-95 transition-colors duration-200 font-medium"
			>
				<Icon name="material-symbols:home" class="text-xl" />
				{i18n(I18nKey.backToHome)}
			</a>

			<!-- 装饰性元素 -->
			<div class="absolute top-4 left-4 opacity-10">
				<Icon
					name="material-symbols:sentiment-sad"
					class="text-4xl text-(--primary)"
				/>
			</div>
			<div class="absolute bottom-4 right-4 opacity-10">
				<Icon
					name="material-symbols:search-off"
					class="text-4xl text-(--primary)"
				/>
			</div>
		</div>
	</div>
</MainGridLayout>

<style>
	/* 添加一些动画效果 */
	.card-base {
		animation: fadeInUp 0.6s ease-out;
	}

	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	/* 按钮悬停效果 */
	a:hover {
		transform: translateY(-2px);
		box-shadow: 0 4px 12px rgba(var(--primary-rgb), 0.3);
	}
</style>

<style is:global>
    .ascii-not-found {
        display: block;
        max-width: 100%;
        font-size: clamp(5px, 1.2vw, 12px);
        color: var(--primary);
    }

    .ascii-not-found pre {
        margin: 0;
        line-height: 1.2;
    }
</style>
